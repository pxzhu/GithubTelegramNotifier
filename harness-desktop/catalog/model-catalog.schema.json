{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/model-catalog.v1.json",
  "title": "Signed Harness Model Catalog Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "generated_at", "models"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "display_name",
          "version",
          "family",
          "parameter_size",
          "quantization",
          "download_size_bytes",
          "required_ram_bytes",
          "recommended_ram_bytes",
          "context_length",
          "capabilities",
          "license",
          "download_url",
          "sha256",
          "runtime",
          "platform_support"
        ],
        "properties": {
          "model_id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 },
          "parameter_size": { "type": "string", "minLength": 1 },
          "quantization": { "type": "string", "minLength": 1 },
          "download_size_bytes": { "type": "integer", "minimum": 1 },
          "required_ram_bytes": { "type": "integer", "minimum": 1 },
          "recommended_ram_bytes": { "type": "integer", "minimum": 1 },
          "required_vram_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "recommended_vram_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "context_length": { "type": "integer", "minimum": 1 },
          "capabilities": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "acceptance_required"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "acceptance_required": { "type": "boolean" }
            }
          },
          "download_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "runtime": { "type": "string", "minLength": 1 },
          "platform_support": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["os", "architectures", "backends"],
              "properties": {
                "os": { "enum": ["macos", "windows", "linux"] },
                "architectures": {
                  "type": "array",
                  "items": { "enum": ["aarch64", "x86_64"] },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "backends": {
                  "type": "array",
                  "items": { "enum": ["cpu", "metal", "cuda", "vulkan", "directml"] },
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    }
  }
}
